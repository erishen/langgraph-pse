OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_MODEL=your-model-name
# 免费 gateway（与 DeepSeek 同 OpenAI 兼容协议）：可选，作为 --provider free 的凭证
# FREE_KEY=your-free-key
# FREE_BASE_URL=https://api.example.com/v1
PSE_MAX_RETRIES=3

# 工作区根目录——read_file / run_bash 沙箱的根路径
PSE_ROOT=/path/to/your/workspace

# crm 数据库路径（crm-qa 任务只读查询与扫描用）
CRM_DB_PATH=/path/to/data/crm.db
